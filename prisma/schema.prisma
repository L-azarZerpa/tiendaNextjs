generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?
  category    String
  volume      String?  // Ej: "750 ml", "1 L"
  abv         Float?   // Porcentaje de alcohol, ej: 40.0
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model User {
  id        String   @id // Almacena el UUID exacto proveniente de Supabase Auth
  email     String   @unique
  role      String   @default("CUSTOMER") // "CUSTOMER" para clientes normales, "ADMIN" para gerencia
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}